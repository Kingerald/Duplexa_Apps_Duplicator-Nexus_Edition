<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core Permissions for Discovering Installed Apps & Extracting Base APKs -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Permissions for Standalone Duplicated APK Installation, Shortcut Pinning & Cleanup -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Legacy External Storage Support for Exporting Duplicated APKs to Downloads (API <= 28) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Explicit Package Visibility Queries for Launcher Apps & Package Installers -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_duplexa"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_duplexa"
        android:supportsRtl="true"
        android:theme="@style/Theme.Duplexa.Theme1.Night">

        <!-- 1. Bootup & Initialization Splash Interface -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Duplexa.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Main Dashboard, Duplicated App Library & App Selection Interface -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- 3. Full-Screen Native Standalone Sandbox Container (Zero WebKit, Zero Toolbars) -->
        <activity
            android:name=".CloneSandboxActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.Duplexa.FullScreenSandbox" />

        <!-- 4. Direct Home-Screen Shortcut & External Intent Router for D_V Instances -->
        <activity
            android:name=".CloneLauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Duplexa.FullScreenSandbox">
            <intent-filter>
                <action android:name="com.duplexa.duplicator.nexus.ACTION_LAUNCH_DUPLICATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 5. FileProvider for Sharing/Installing Standalone D_V# APKs via System Chooser -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
